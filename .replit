modules = ["python-3.11"]

[nix]
packages = ["glibcLocales"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "App"
mode = "sequential"
author = 46154419

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[[workflows.workflow]]
name = "Start"
mode = "sequential"
author = 46154419

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App"
